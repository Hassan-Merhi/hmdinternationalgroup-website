NODE_ENV=development
PORT=3001
# Production requires at least 32 characters. Render generates this automatically.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
# Use a unique passphrase of at least 14 characters.
ADMIN_PASSWORD=replace-with-a-strong-unique-admin-passphrase
# Optional locally. Render Blueprint wires this to Render Postgres automatically.
DATABASE_URL=
